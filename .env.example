# Configuração do Flask
# IMPORTANTE: Gere uma chave secreta forte e única para produção
# Use: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=sua-chave-secreta-aqui-mude-isso

# Banco de Dados
# Desenvolvimento: sqlite:///tarefas.db
# Produção: postgresql://usuario:senha@localhost/nome_banco
DATABASE_URL=sqlite:///tarefas.db

# Ambiente (development ou production)
FLASK_ENV=development

# Fuso horário
# A aplicação grava os horários no fuso do sistema e os exibe exatamente como
# estão gravados, sem converter. Portanto é este valor que aparece na tela.
# Use um nome da base IANA, por exemplo America/Sao_Paulo, America/Manaus,
# America/Belem ou UTC.
# Ao trocar depois que já houver dados, os registros antigos continuam no fuso
# em que foram gravados: a coluna não guarda essa informação.
TZ=America/Sao_Paulo

# Configurações de Segurança de Cookies (usar True em produção com HTTPS)
SESSION_COOKIE_SECURE=False
WTF_CSRF_SSL_STRICT=False

# Para produção com HTTPS, descomente e use:
# SESSION_COOKIE_SECURE=True
# WTF_CSRF_SSL_STRICT=True
# FLASK_ENV=production

# Proxy reverso: identificação do visitante
#
# Com qualquer proxy na frente (Cloudflare Tunnel, nginx), todas as requisições
# chegam do mesmo endereço local e o IP real vem em um cabeçalho. Sem apontar
# qual é esse cabeçalho, o limite de tentativas de login conta todo mundo em um
# balde só e um atacante tranca a aplicação para todos os usuários.
#
#   Cloudflare Tunnel : CLIENT_IP_HEADER=CF-Connecting-IP
#   nginx             : CLIENT_IP_HEADER=X-Forwarded-For
#   acesso direto     : deixe vazio
#
# Só preencha se a aplicação for inalcançável por fora do proxy. Se a porta
# puder ser acessada diretamente, qualquer um forja o cabeçalho e escapa do
# limite trocando de endereço a cada tentativa.
CLIENT_IP_HEADER=

# Número de proxies reversos na frente da aplicação. Afeta o esquema e o host
# que a aplicação enxerga (url_for externo, detecção de HTTPS). Com Cloudflare
# Tunnel pode ficar 0: o cloudflared já envia X-Forwarded-Proto, que o
# Flask-Talisman lê por conta própria.
TRUSTED_PROXY_COUNT=0

# Limite de tentativas de login
# Em memória (padrão) cada worker do gunicorn mantém a própria contagem, então
# o limite efetivo fica multiplicado pelo número de workers. Para um limite
# exato, use um Redis compartilhado:
# RATELIMIT_STORAGE_URI=redis://localhost:6379
RATELIMIT_STORAGE_URI=memory://

# Tentativas de login MAL-SUCEDIDAS permitidas por endereço. Acertar a senha
# não consome cota, então quem sabe a senha nunca esbarra nestes números.
# Atenção: não existe recuperação de senha na aplicação. Um usuário trancado
# precisa que o administrador redefina a senha (create_user.py, opção 3).
LOGIN_RATE_LIMIT=3 per minute; 10 per hour; 25 per day

# Processos do gunicorn. O SQLite aceita um escritor por vez, então subir muito
# este número aumenta a disputa por escrita sem ganho real. Também afeta a
# precisão do limite acima quando o contador fica em memória: cada processo
# mantém a própria contagem.
GUNICORN_WORKERS=2

# Permissões do Docker (para evitar arquivos criados como root)
# Use: id -u para obter seu UID e id -g para obter seu GID
UID=1000
GID=1000
