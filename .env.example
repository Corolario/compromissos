# =============================================================
# Configuração da aplicação
#
# Copie este arquivo para .env e ajuste o que precisar:
#     cp .env.example .env
#
# Este é o único lugar de configuração: o docker-compose.yml lê
# este arquivo e repassa tudo ao contêiner. Os valores abaixo já
# estão prontos para PRODUÇÃO — veja a última seção para rodar
# em desenvolvimento.
# =============================================================

# ----- OBRIGATÓRIO -----

# Assina os cookies de sessão. Deixe em branco aqui de propósito: com uma chave
# conhecida, qualquer pessoa monta um cookie válido e entra como administrador.
# A aplicação recusa iniciar enquanto estiver vazia.
#
# Gere a sua com:
#     python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=

# ----- Banco de dados -----

# Não há variável a definir aqui, de propósito.
#
# No contêiner o caminho é fixado pelo docker-compose.yml, apontando para o
# volume em data/. Ele precisa ser absoluto: um caminho relativo seria
# resolvido dentro de instance/, fora do volume, e os dados se perderiam ao
# recriar o contêiner. Definir DATABASE_URL neste arquivo não altera isso.
#
# Rodando fora do contêiner (python app.py), o banco fica em
# instance/tarefas.db. Para usar outro arquivo nesse caso, acrescente:
#     DATABASE_URL=sqlite:///outro.db

# ----- Fuso horário -----

# Os horários são gravados e exibidos neste fuso, sem conversão: é o que
# aparece na tela. Use um nome da base IANA (America/Sao_Paulo, America/Manaus,
# America/Belem, UTC...).
# Ao trocar depois que já houver dados, os registros antigos permanecem no fuso
# em que foram gravados: a coluna não guarda essa informação.
TZ=America/Sao_Paulo

# ----- Ambiente -----

# Em production a aplicação exige HTTPS, envia HSTS e aplica Content Security
# Policy. Exige TLS na frente (Cloudflare Tunnel ou nginx com certificado).
FLASK_ENV=production

# Cookie de sessão apenas por HTTPS, e verificação estrita de origem no CSRF.
SESSION_COOKIE_SECURE=True
WTF_CSRF_SSL_STRICT=True

# ----- Proxy reverso -----

# Cabeçalho que traz o IP real de quem acessa. Sem ele, atrás de um proxy todas
# as requisições parecem vir do mesmo lugar e o limite de tentativas de login
# tranca a aplicação para todos os usuários de uma vez.
#
#     Cloudflare Tunnel : CF-Connecting-IP
#     nginx             : X-Forwarded-For
#     acesso direto     : deixe vazio
#
# Só preencha se a aplicação for inalcançável por fora do proxy. Se a porta
# puder ser acessada diretamente, o cabeçalho pode ser forjado para escapar do
# limite.
CLIENT_IP_HEADER=

# Número de proxies na frente. Afeta o esquema e o host que a aplicação
# enxerga. Com Cloudflare Tunnel pode ficar 0: o cloudflared já envia
# X-Forwarded-Proto, que é o que o Flask-Talisman consulta.
TRUSTED_PROXY_COUNT=0

# ----- Limite de tentativas de login -----

# Tentativas MAL-SUCEDIDAS permitidas por endereço. Acertar a senha não consome
# cota, então quem sabe a senha nunca esbarra nestes números.
#
# O bloqueio é temporário e se desfaz sozinho: cada janela conta a partir da
# primeira tentativa dela, então a espera é de até 1 minuto, 1 hora ou 24 horas,
# conforme o limite atingido. Ninguém precisa ser destravado manualmente.
#
# O administrador só entra em cena quando a pessoa realmente esqueceu a senha,
# já que a aplicação não tem recuperação por conta própria (create_user.py,
# opção 3).
LOGIN_RATE_LIMIT=3 per minute; 10 per hour; 25 per day

# Onde fica o contador. Em memória cada processo conta separadamente, então o
# limite efetivo é multiplicado pelo número de workers. Para um limite exato,
# use um Redis compartilhado: redis://localhost:6379
RATELIMIT_STORAGE_URI=memory://

# ----- Servidor -----

# Processos do gunicorn. O SQLite aceita um escritor por vez, então subir muito
# este número aumenta a disputa por escrita sem ganho real.
GUNICORN_WORKERS=2

# Dono dos arquivos criados em data/, para não ficarem como root.
# Descubra os seus com: id -u  e  id -g
UID=1000
GID=1000

# =============================================================
# Rodando em desenvolvimento (python app.py)
#
# Os valores acima são de produção e exigem HTTPS. Para trabalhar
# em http://localhost, troque estas três linhas:
#
#     FLASK_ENV=development
#     SESSION_COOKIE_SECURE=False
#     WTF_CSRF_SSL_STRICT=False
#
# Sem isso o navegador é redirecionado para HTTPS e o cookie de
# sessão não é enviado, impedindo o login.
# =============================================================
