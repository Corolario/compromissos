# Configuração do Flask
# IMPORTANTE: Gere uma chave secreta forte e única para produção
# Use: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=sua-chave-secreta-aqui-mude-isso

# Banco de Dados
# Desenvolvimento: sqlite:///tarefas.db
# Produção: postgresql://usuario:senha@localhost/nome_banco
DATABASE_URL=sqlite:///tarefas.db

# Ambiente (development ou production)
FLASK_ENV=development

# Configurações de Segurança de Cookies (usar True em produção com HTTPS)
SESSION_COOKIE_SECURE=False
WTF_CSRF_SSL_STRICT=False

# Para produção com HTTPS, descomente e use:
# SESSION_COOKIE_SECURE=True
# WTF_CSRF_SSL_STRICT=True
# FLASK_ENV=production

# Proxy reverso
# Número de proxies (nginx) na frente da aplicação. Necessário para que o
# limite de tentativas de login identifique o IP real de cada visitante.
# Mantenha 0 se a porta 5000 for acessada diretamente: confiar no cabeçalho
# X-Forwarded-For sem proxy permitiria forjá-lo e escapar do limite.
TRUSTED_PROXY_COUNT=0

# Limite de tentativas de login
# Em memória (padrão) cada worker do gunicorn mantém a própria contagem, então
# o limite efetivo fica multiplicado pelo número de workers. Para um limite
# exato, use um Redis compartilhado:
# RATELIMIT_STORAGE_URI=redis://localhost:6379
RATELIMIT_STORAGE_URI=memory://

# Permissões do Docker (para evitar arquivos criados como root)
# Use: id -u para obter seu UID e id -g para obter seu GID
UID=1000
GID=1000
